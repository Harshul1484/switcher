{
  "name": "switcher",
  "version": "1.1.6",
  "private": true,
  "description": "Switch between Claude Code accounts with one click",
  "author": "Switcher",
  "license": "MIT",
  "homepage": "https://github.com/Harshul1484/switcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "local.switcher.app",
    "productName": "Switcher",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "quick.html",
      "quick.js",
      "assets/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Switcher-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Switcher-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "executableName": "switcher",
      "maintainer": "Harshul1484 <Harshul1484@users.noreply.github.com>",
      "synopsis": "Switch between Claude Code accounts with one click"
    },
    "appImage": {
      "artifactName": "Switcher-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "switcher_${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "switcher.${arch}.${ext}"
    },
    "pacman": {
      "artifactName": "switcher.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Harshul1484",
      "repo": "switcher",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "electron-updater": "^6.8.11"
  }
}
